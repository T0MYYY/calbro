    "Select all that apply. Keto, low-carb and high-protein change your macro split.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle alles Zutreffende. Keto, Low Carb und proteinreich ändern deine Makroverteilung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona todas las que correspondan. Keto, baja en carbohidratos y alta en proteína cambian tu reparto de macros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez tout ce qui s'applique. Céto, pauvre en glucides et riche en protéines modifient la répartition des macros."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "該当するものをすべて選択してください。ケト、低炭水化物、高たんぱくはマクロの配分が変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당하는 항목을 모두 선택하세요. 키토, 저탄수화물, 고단백은 매크로 비율을 바꿔요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione todas as opções aplicáveis. Cetogênica, low carb e rica em proteína mudam sua divisão de macros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可多选。生酮、低碳水和高蛋白会改变宏量营养素配比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可複選。生酮、低碳水和高蛋白會改變巨量營養素比例。"
          }
        }
      }
    },
