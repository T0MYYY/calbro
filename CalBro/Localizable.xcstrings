    "Replaces the activity estimate in today's budget with calories burned": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt die Aktivitätsschätzung im heutigen Budget durch verbrannte Kalorien"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye la actividad estimada del presupuesto de hoy por las calorías quemadas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace l'estimation d'activité du budget du jour par les calories brûlées"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の予算のアクティビティ推定値を実際の消費カロリーに置き換えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 예산의 활동 추정치를 소모 칼로리로 대체"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui a atividade estimada no orçamento de hoje pelas calorias queimadas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用实际消耗热量替换今日预算中的活动估算"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以實際消耗熱量取代今日預算中的活動估算"
          }
        }
      }
    },
