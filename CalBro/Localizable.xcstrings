    "You can still tap the shutter to try.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst trotzdem auf den Auslöser tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún puedes tocar el obturador para intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez quand même toucher le déclencheur pour essayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シャッターをタップして試すこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셔터를 탭해 시도할 수도 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda pode tocar no obturador para tentar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你仍可轻点快门尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你仍可點一下快門嘗試。"
          }
        }
      }
    },
    "You haven't logged anything today. Snap your next meal to keep your streak.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast heute noch nichts erfasst. Fotografiere deine nächste Mahlzeit, um deine Serie zu halten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy no has registrado nada. Fotografía tu próxima comida para mantener la racha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez rien noté aujourd'hui. Photographiez votre prochain repas pour garder votre série."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はまだ何も記録していません。次の食事を撮影して連続記録を続けましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 아직 아무것도 기록하지 않았어요. 다음 식사를 찍어 연속 기록을 이어가세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não registrou nada hoje. Fotografe sua próxima refeição para manter a sequência."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你今天还没有记录。拍下下一餐以保持连续记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你今天還沒有記錄。拍下下一餐以保持連續記錄。"
          }
        }
      }
    },
    "You're at your target weight": {
      "localizations": {
        "de": {
