    "Maintenance calories are a formula estimate. Log meals and weigh in for two weeks to calibrate them on the Weight trend screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhaltungskalorien sind eine Formelschätzung. Erfasse zwei Wochen lang Mahlzeiten und Gewicht, um sie unter „Gewichtstrend“ zu kalibrieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las calorías de mantenimiento son una estimación por fórmula. Registra comidas y pésate durante dos semanas para calibrarlas en la pantalla Tendencia de peso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les calories de maintien sont une estimation par formule. Notez vos repas et pesez-vous pendant deux semaines pour les calibrer dans l'écran Tendance du poids."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "維持カロリーは計算式による推定値です。2週間食事と体重を記録すると、「体重の推移」画面で調整できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지 칼로리는 공식에 따른 추정치예요. 2주 동안 식사와 체중을 기록하면 체중 추이 화면에서 보정할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As calorias de manutenção são uma estimativa por fórmula. Registre refeições e se pese por duas semanas para calibrá-las na tela Tendência de peso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "维持热量为公式估算值。记录餐食并称重两周后，即可在“体重趋势”页面校准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "維持熱量為公式估算值。記錄餐點並量體重兩週後，即可在「體重趨勢」畫面校準。"
          }
        }
      }
    },
    "Maintenance calories calibrated from your logs on %@. They refresh every two weeks while you keep logging.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhaltungskalorien am %@ aus deinen Einträgen kalibriert. Sie werden alle zwei Wochen aktualisiert, solange du weiter erfasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calorías de mantenimiento calibradas con tus registros el %@. Se actualizan cada dos semanas mientras sigas registrando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calories de maintien calibrées d'après votre journal le %@. Elles sont mises à jour toutes les deux semaines tant que vous continuez à noter vos repas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に記録から維持カロリーを調整しました。記録を続けると2週間ごとに更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 기록을 바탕으로 유지 칼로리를 보정했어요. 계속 기록하면 2주마다 업데이트돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calorias de manutenção calibradas pelos seus registros em %@. Elas são atualizadas a cada duas semanas enquanto você continuar registrando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "维持热量已于 %@ 根据你的记录校准。持续记录期间每两周更新一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "維持熱量已於 %@ 根據你的記錄校準。持續記錄期間每兩週更新一次。"
          }
        }
      }
    },
