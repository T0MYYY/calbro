    "Needs two weeks of weigh-ins and at least 10 logged days in the last four weeks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benötigt zwei Wochen Wiegungen und mindestens 10 erfasste Tage in den letzten vier Wochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere dos semanas de pesajes y al menos 10 días registrados en las últimas cuatro semanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite deux semaines de pesées et au moins 10 jours saisis sur les quatre dernières semaines."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2週間分の体重記録と、過去4週間で10日以上の食事記録が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2주간의 체중 기록과 최근 4주 중 10일 이상의 식사 기록이 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer duas semanas de pesagens e pelo menos 10 dias registrados nas últimas quatro semanas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要最近四周内有两周的称重记录，且至少记录 10 天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要最近四週內有兩週的體重記錄，且至少記錄 10 天。"
          }
        }
      }
    },
