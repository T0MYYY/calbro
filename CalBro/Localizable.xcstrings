    "Your weight is moving away from your goal. Check that every meal is logged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gewicht entfernt sich von deinem Ziel. Prüfe, ob jede Mahlzeit erfasst ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peso se aleja de tu objetivo. Comprueba que registras todas las comidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre poids s'éloigne de votre objectif. Vérifiez que chaque repas est noté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体重が目標から遠ざかっています。すべての食事を記録しているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중이 목표에서 멀어지고 있어요. 모든 식사를 기록했는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu peso está se afastando do objetivo. Confira se todas as refeições estão registradas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的体重正偏离目标。请确认每餐都已记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的體重正偏離目標。請確認每餐都已記錄。"
          }
        }
      }
    },
